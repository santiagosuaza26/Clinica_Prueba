# ===============================================
# 🏥 CLINIC IPS - Environment Configuration
# ===============================================
# Configuración para despliegue con Docker

# 🌐 Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# 🔐 JWT Security Configuration
JWT_SECRET=mi_clave_jwt_muy_segura_para_produccion_min_256_bits_minima_para_docker
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 🗄️ Database Configuration
# PostgreSQL
POSTGRES_DB=clinic_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=clinic_pass
POSTGRES_PORT=5432

# MongoDB
MONGO_HOST=clinic_mongo
MONGO_PORT=27017
MONGO_DATABASE=clinic_db
MONGO_USERNAME=clinic_user
MONGO_PASSWORD=clinic_pass
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin_pass

# 📧 Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@clinica-ips.com

# 🔒 Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:80,http://localhost:443
ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,Access-Control-Request-Method,Access-Control-Request-Headers,X-Username,X-Environment,Role
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# 🚀 Application Configuration
APP_NAME=Clínica IPS
APP_VERSION=1.0.0
APP_ENVIRONMENT=production

# 📊 Monitoring and Logging
LOG_LEVEL=INFO
LOG_FILE=logs/clinic-ips.log
ENABLE_ACTUATOR=true
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=actuator_password

# 🔧 Development Configuration
DEBUG=false
H2_CONSOLE_ENABLED=false
H2_CONSOLE_PATH=/h2-console

# 📁 File Upload Configuration
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx

# ⏰ Scheduling Configuration
SCHEDULER_ENABLED=true
BACKUP_CRON=0 0 2 * * ?
REPORT_CRON=0 0 8 * * ?

# 🔄 Cache Configuration
CACHE_TTL=3600000
CACHE_MAX_SIZE=1000

# 🌍 Internationalization
DEFAULT_LOCALE=es_CO
SUPPORTED_LOCALES=es_CO,en_US

# 📱 API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600000

# 🔐 Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# 📞 SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# 🔔 Notification Configuration
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAILS=admin@clinica-ips.com,manager@clinica-ips.com
SMS_NOTIFICATIONS_ENABLED=false

# 📊 Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=internal
ANALYTICS_API_KEY=your_analytics_key

# 🔧 External Services
WEATHER_API_KEY=your_weather_api_key
CURRENCY_API_KEY=your_currency_api_key

# 🏢 Business Configuration
CLINIC_NAME=Clínica IPS
CLINIC_ADDRESS=Calle 123 #45-67, Ciudad
CLINIC_PHONE=+57 1 234 5678
CLINIC_EMAIL=info@clinica-ips.com

# 💰 Financial Configuration
DEFAULT_CURRENCY=COP
TAX_RATE=19.0
INSURANCE_COMMISSION=5.0

# 📅 Business Hours
BUSINESS_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
APPOINTMENT_DURATION=30

# 🔒 SSL/TLS Configuration (Production)
SSL_ENABLED=false
SSL_KEYSTORE_PATH=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=keystore_password
SSL_KEY_ALIAS=tomcat

# 🌐 Docker Configuration
DOCKER_ENABLED=true
DOCKER_REGISTRY=your-registry.com
DOCKER_TAG=latest

# 📦 Backup Configuration
BACKUP_ENABLED=true
BACKUP_LOCATION=/backups
BACKUP_RETENTION_DAYS=30

# 🔄 CI/CD Configuration
CI_ENABLED=false
CD_ENABLED=false
DEPLOY_BRANCH=main

# 📊 Performance Configuration
CONNECTION_POOL_SIZE=20
CONNECTION_POOL_TIMEOUT=30000
MAX_FILE_SIZE=50MB

# 🏥 Medical Configuration
EMERGENCY_PHONE=911
EMERGENCY_EMAIL=emergencias@clinica-ips.com
APPOINTMENT_REMINDER_HOURS=24

# 🔧 Development Tools
LIVE_RELOAD_ENABLED=false
DEBUG_PORT=5005
JMX_ENABLED=false

# 📱 Mobile App Configuration
MOBILE_API_ENABLED=true
MOBILE_VERSION=1.0.0
MOBILE_PLATFORM=ANDROID,IOS

# 🌐 CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.clinica-ips.com

# 📈 Metrics Configuration
METRICS_ENABLED=true
METRICS_EXPORT=true
METRICS_ENDPOINT=/actuator/metrics

# 🔐 OAuth2 Configuration (Optional)
OAUTH2_ENABLED=false
OAUTH2_CLIENT_ID=your_oauth2_client_id
OAUTH2_CLIENT_SECRET=your_oauth2_client_secret
OAUTH2_ISSUER_URI=https://your-oauth2-provider.com

# 📊 Database Migration
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true

# 🔧 Testing Configuration
TEST_DATABASE_URL=jdbc:h2:mem:testdb
TEST_DATABASE_USERNAME=sa
TEST_DATABASE_PASSWORD=

# 📝 Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/swagger-ui.html
API_DOCS_TITLE=Clínica IPS API
API_DOCS_DESCRIPTION=Sistema de Gestión Clínica IPS - API REST

# 🚨 Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
CSP_ENABLED=true

# 📊 Monitoring
MONITORING_DASHBOARD_URL=http://localhost:9090
ALERT_EMAILS=devops@clinica-ips.com

# 🔄 Integration Services
INTEGRATION_API_KEY=your_integration_api_key
WEBHOOK_SECRET=your_webhook_secret

# 📱 Push Notifications
PUSH_ENABLED=false
PUSH_API_KEY=your_push_api_key
PUSH_SECRET=your_push_secret

# 🌍 Localization
DEFAULT_TIMEZONE=America/Bogota
SUPPORTED_TIMEZONES=America/Bogota,America/New_York,America/Mexico_City

# 📦 Package Configuration
NPM_REGISTRY=https://registry.npmjs.org/
MAVEN_CENTRAL=https://repo.maven.apache.org/maven2

# 🔧 Build Configuration
BUILD_TOOL=maven
BUILD_PROFILES=production
BUILD_OPTIMIZATION=true

# 📊 Analytics and Tracking
TRACKING_ENABLED=false
TRACKING_ID=your_tracking_id
ANALYTICS_SCRIPT_URL=

# 🔐 Encryption
ENCRYPTION_ALGORITHM=AES
ENCRYPTION_KEY=your_32_character_encryption_key

# 📱 API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600000

# 🌐 CORS Configuration
CORS_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true

# 📊 Database Connection Pool
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30000

# 🔧 JVM Configuration
JVM_OPTS=-Xmx2g -Xms1g -XX:+UseG1GC
JVM_DEBUG_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005

# 📈 Performance Monitoring
PERF_MONITORING_ENABLED=true
PERF_SLA_RESPONSE_TIME=3000
PERF_SLA_UPTIME=99.9

# 🔐 Security Audit
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=WARN
AUDIT_LOG_LOCATION=logs/audit.log

# 📱 Mobile Push Configuration
MOBILE_PUSH_PLATFORM=FIREBASE
MOBILE_PUSH_SERVER_KEY=your_firebase_server_key

# 🌐 WebSocket Configuration
WEBSOCKET_ENABLED=false
WEBSOCKET_PATH=/ws
WEBSOCKET_PORT=8080

# 📊 Business Intelligence
BI_ENABLED=false
BI_API_KEY=your_bi_api_key
BI_DASHBOARD_URL=https://bi.clinica-ips.com

# 🏥 Medical Configuration (Docker specific)
# Configuración específica para contenedores Docker
NGINX_PORT=80
NGINX_SSL_PORT=443

# 🔧 Docker Environment Variables
COMPOSE_PROJECT_NAME=clinic-ips
